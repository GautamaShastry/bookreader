{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookscope.example.invalid/schemas/book-brief-v1.3.schema.json",
  "title": "BookBriefResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book_id",
    "book_version_id",
    "book_status",
    "status",
    "brief_spec_version",
    "chapters",
    "overview",
    "key_concepts",
    "citations",
    "coverage",
    "updated_at"
  ],
  "properties": {
    "book_id": {
      "type": "string",
      "format": "uuid"
    },
    "book_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "book_status": {
      "type": "string",
      "enum": [
        "uploaded",
        "parsing",
        "indexing",
        "ready",
        "failed",
        "deleting",
        "deleted"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "generating",
        "verifying",
        "ready",
        "partial",
        "failed",
        "unavailable"
      ]
    },
    "brief_spec_version": {
      "type": "string",
      "minLength": 1
    },
    "overview": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 8
    },
    "key_concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 15
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Chapter"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "chapter_count",
        "chapters_verified",
        "chapters_unavailable",
        "completeness_label"
      ],
      "additionalProperties": false,
      "properties": {
        "chapter_count": {
          "type": "integer",
          "minimum": 0
        },
        "chapters_verified": {
          "type": "integer",
          "minimum": 0
        },
        "chapters_unavailable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completeness_label": {
          "type": "string",
          "enum": [
            "verified_orientation",
            "partial_orientation",
            "outline_only",
            "unavailable"
          ]
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "Claim": {
      "type": "object",
      "required": [
        "claim_id",
        "text",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Chapter": {
      "type": "object",
      "required": [
        "chapter_id",
        "title",
        "status",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "outline_only",
            "unavailable"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Citation": {
      "type": "object",
      "required": [
        "source_id",
        "chapter_id",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string"
        },
        "chapter_id": {
          "type": "string"
        },
        "locator": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      }
    }
  }
}
